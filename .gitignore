# 機密情報・環境設定（絶対に git に含めない）
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/
.ruff_cache/

# Config の補完スタブ（自動生成。エディタ補完専用なので git に含めない）
typings/
config.pyi

# ログ・出力・一時ファイル
logs/
*.log

# 出力先（試した CSV。実データを含むため git に含めない）
output/*
!output/.gitkeep

# 試すレポート定義（.py）。実データ（SOQL・列名）を含むため git に含めない
reports/*.py
!reports/.gitkeep
